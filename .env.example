# Gemini API key - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://vocare:vocare@localhost:5432/vocare

# Model IDs - Gemini model names change fairly often; verify current IDs at
# https://ai.google.dev/gemini-api/docs/models before relying on these.
VOCARE_TEXT_MODEL=gemini-2.5-flash
VOCARE_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
VOCARE_EMBEDDING_MODEL=gemini-embedding-001
VOCARE_EMBEDDING_DIM=768

# Logging
VOCARE_LOG_LEVEL=INFO
VOCARE_LOG_FILE=vocare.log

# `vocare voice` always prints the reply as text. Set this to true to also
# have it spoken back (Live API TTS); default is text-only (faster, no extra
# Live API round trip).
VOCARE_VOICE_REPLY=false

# Tool-calling/MCP (calculator, clock, kb_search, mock device control) is a
# demonstrable add-on, not something the app depends on - set to false to run
# with plain RAG chat/voice and no MCP subprocess at all.
VOCARE_ENABLE_TOOLS=true
